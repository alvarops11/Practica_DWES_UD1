<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= taller.titulo %></title>
</head>
<body>
  <h1><%= taller.titulo %></h1>

  <p>Categoría: <%= taller.categoria %></p>
  <p>Nivel: <%= taller.nivel %></p>
  <p>Plazas totales: <%= taller.plazas %></p>
  <p>Plazas restantes: <%= plazasRestantes %></p>

  <p><strong>Estado:</strong> <%= estado %></p>

  <% if (plazasRestantes > 0) { %>
    <a href="/talleres/<%= taller.id %>/inscripcion">
      Inscribirme
    </a>
  <% } else { %>
    <p>Este taller ya no admite inscripciones.</p>
  <% } %>

  <p><a href="/talleres">Volver al catálogo</a></p>
</body>
</html>